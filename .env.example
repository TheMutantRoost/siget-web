# Copie este archivo como backend/.env en desarrollo. Nunca suba valores reales.
ENTORNO=desarrollo                # desarrollo | pruebas | demo | produccion
DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/siget_dev
COOKIE_SEGURA=false               # true cuando el sitio se sirve por HTTPS
# Solo para el primer arranque en el servidor (start.sh crea el administrador si no existe):
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@unab.edu.pe
ADMIN_PASSWORD=
# 1 = carga datos de ejemplo al arrancar (se niega con ENTORNO=produccion)
CARGAR_DATOS_DEMO=0
